# Copy this file to .env and fill it in. Git ignores .env, so what you put there is never uploaded.
# Never put a real key in this example file: it IS uploaded.

# The language model's key, from console.anthropic.com under API keys.
ANTHROPIC_API_KEY=

# Optional. Leave out to use the local file data/local.db.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
